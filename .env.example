# Base de données. Vercel Postgres (Neon) fournit ces variables automatiquement
# une fois le store rattaché au projet. En local, copie l'URL « pooled » depuis
# le dashboard Vercel ou Neon.
DATABASE_URL=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret de signature du cookie de session, 32 caractères minimum.
# Génère-le avec : openssl rand -base64 32
AUTH_SECRET=

# Phase 2 : clé utilisée par le serveur MCP pour dériver les jetons de foyer.
# Laisse vide tant que la phase 2 n'est pas livrée.
MCP_TOKEN_SECRET=
